# Alice Backend env vars
# --------------------------------------------------------------
# Copy this file to `.env` and fill in your real values.
# NEVER commit a real `.env` — it is in .gitignore.

# ---------- Clerk Authentication ----------
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# ---------- Supabase ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me

# ---------- OpenAI / OpenRouter ----------
OPENAI_API_KEY=sk-or-v1-replace_me
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Anthropic Sonnet is recommended for the Alice agent (more rigorous
# against hallucinated prices). Override per workspace if needed.
OPENAI_MODEL=anthropic/claude-3.5-sonnet

# ---------- Meta (WhatsApp / Instagram) ----------
META_BUSINESS_ACCOUNT_ID=replace_me
META_ACCESS_TOKEN=replace_me
META_WEBHOOK_VERIFY_TOKEN=replace_me

# ---------- Google Calendar ----------
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN.vercel.app/api/appointments/auth/callback

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ---------- Redis (only needed for the external worker) ----------
REDIS_URL=redis://localhost:6379

# ---------- Express ----------
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
JWT_SECRET=replace_me_with_a_long_random_string

# ---------- Vercel (auto-set by the platform, but useful for local) ----------
VERCEL=0
