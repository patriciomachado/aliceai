# Alice Frontend env vars (Vite uses VITE_ prefix on the client)
#
# Local dev defaults are baked into src/services/api.js, so these are
# only required for production deploys (e.g. Vercel).

# Production: leave unset to use the /api rewrite on the same origin.
# If you deploy the backend to a different host (Render/Railway),
# set this to that full URL, e.g. https://api.alice.com/api
VITE_API_URL=

# Clerk publishable key (public — safe to expose in the bundle)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_ZGFybGluZy1zcG9uZ2UtNzUuY2xlcmsuYWNjb3VudHMuZGV2JA
